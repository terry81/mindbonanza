# Content must always be revalidated. This prevents browsers, Cloudflare, and
# service workers from showing an old deployment after new content is published.
/*.html
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

# Clean content URLs - no browser or edge caching
/index.html
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

/
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN

# Blog pages
/blog/
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/blog/*
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# Course, tools, and post pages
/tools/
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/courses/*
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# CSS and JavaScript use stable filenames, so retain them for at most one day.
/css/*.css
  Cache-Control: public, max-age=86400, must-revalidate
  X-Content-Type-Options: nosniff

/js/*.js
  Cache-Control: public, max-age=86400, must-revalidate
  X-Content-Type-Options: nosniff

# The service worker controls all navigations, so never cache its script.
/sw.js
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  X-Content-Type-Options: nosniff

# Images and fonts can be retained for a week, but must revalidate afterwards.
/assets/*.jpg
  Cache-Control: public, max-age=604800, must-revalidate
  X-Content-Type-Options: nosniff

/assets/*.jpeg
  Cache-Control: public, max-age=604800, must-revalidate
  X-Content-Type-Options: nosniff

/assets/*.png
  Cache-Control: public, max-age=604800, must-revalidate
  X-Content-Type-Options: nosniff

/assets/*.gif
  Cache-Control: public, max-age=604800, must-revalidate
  X-Content-Type-Options: nosniff

/assets/*.webp
  Cache-Control: public, max-age=604800, must-revalidate
  X-Content-Type-Options: nosniff

/assets/*.svg
  Cache-Control: public, max-age=604800, must-revalidate
  X-Content-Type-Options: nosniff

/assets/*.woff
  Cache-Control: public, max-age=604800, must-revalidate
  X-Content-Type-Options: nosniff

/assets/*.woff2
  Cache-Control: public, max-age=604800, must-revalidate
  X-Content-Type-Options: nosniff

/assets/*.ttf
  Cache-Control: public, max-age=604800, must-revalidate
  X-Content-Type-Options: nosniff

/assets/*.otf
  Cache-Control: public, max-age=604800, must-revalidate
  X-Content-Type-Options: nosniff

# Interactive tools and their clean URLs are content, not long-lived assets.
/assets/*.html
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN

/assets/*/
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# Published articles and search data
/posts/*
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN

/search-index.json
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# Search engine metadata is refreshed hourly.
/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff

/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff

# Default for everything else
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
