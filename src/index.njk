---
layout: base.njk
title: Discover Your Inner Peace
---

<!-- Hero Section -->
<section class="hero home-hero" aria-labelledby="home-hero-title">
    <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-two" aria-hidden="true"></div>
    <div class="container hero-layout">
        <div class="hero-content">
            <p class="eyebrow">Mindfulness for real life</p>
            <h1 id="home-hero-title">Find calm, focus, and clarity—one mindful moment at a time.</h1>
            <p>Explore evidence-informed articles, structured courses, and practical tools that make mindfulness easier to start and sustain.</p>
            <div class="hero-actions">
                <a href="/assets/meditation-timer/" class="cta-button cta-button-primary">Start a 5-minute practice</a>
                <a href="/courses/" class="cta-button cta-button-secondary">Explore courses</a>
            </div>
            <div class="hero-metrics" aria-label="Mind Bonanza resources">
                <div>
                    <strong>100+</strong>
                    <span>Mindfulness articles</span>
                </div>
                <div>
                    <strong>14</strong>
                    <span>Practice tools</span>
                </div>
                <div>
                    <strong>4</strong>
                    <span>Guided programs</span>
                </div>
            </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
            <div class="mindful-card mindful-card-primary">
                <span class="mindful-card-icon">🧘</span>
                <div>
                    <strong>Today’s practice</strong>
                    <span>3 mindful breaths before your next task</span>
                </div>
            </div>
            <div class="breath-ring">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <div class="mindful-card mindful-card-secondary">
                <span class="mindful-card-icon">🌿</span>
                <div>
                    <strong>Gentle progress</strong>
                    <span>Small practices, repeated daily</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Affiliate Banner Section -->
{% include "affiliate-banner.njk" %}

<!-- Blog Preview Section -->
<section class="blog-preview">
    <div class="container">
        <h2 class="section-title">Latest From Our Blog</h2>
        <div class="blog-grid">
            {%- set postCount = 0 -%}
            {%- for post in collections.posts -%}
            {%- if postCount < 6 -%}
            {%- set postCount = postCount + 1 -%}
            <article class="blog-card">
                {% if post.data.image %}
                <picture class="blog-card-image-wrapper">
                    <source
                        srcset="{{ post.data.image }}?auto=format&fit=crop&w=600&h=400&q=80&fm=webp"
                        type="image/webp"
                        media="(min-width: 768px)">
                    <source
                        srcset="{{ post.data.image }}?auto=format&fit=crop&w=400&h=300&q=75&fm=webp"
                        type="image/webp">
                    <img
                        src="{{ post.data.image }}?auto=format&fit=crop&w=600&h=400&q=80"
                        alt="{{ post.data.title }} - {{ post.data.excerpt | striptags | truncate(80) }}"
                        width="600"
                        height="400"
                        loading="lazy"
                        decoding="async"
                        class="blog-card-image">
                </picture>
                {% endif %}
                <div class="blog-card-content">
                    <span class="blog-category">{{ post.data.category }}</span>
                    <h3>{{ post.data.title }}</h3>
                    <p class="blog-excerpt">{{ post.data.excerpt }}</p>
                    <div class="blog-meta">
                        <span>{{ post.data.date | dateDisplay }}</span>
                    </div>
                    <a href="{{ post.url }}" class="read-more">Read More →</a>
                </div>
            </article>
            {%- endif -%}
            {%- endfor -%}
        </div>
        <div class="section-action">
            <a href="/blog/" class="cta-button">View All Posts</a>
        </div>
    </div>
</section>

